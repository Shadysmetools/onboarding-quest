# Copy to .env for local dev (never commit .env). On Vercel, set these in
# Project Settings > Environment Variables instead.

# --- Access keys (required to save progress) ---
# Long random strings. Generate one with:
#   node -e "console.log(crypto.randomUUID())"
# The learner opens  <dashboard>/?k=PROGRESS_KEY  once; mentors use ADMIN_KEY.
PROGRESS_KEY=change-me-learner-key
ADMIN_KEY=change-me-mentor-key

# --- Storage (optional locally, required on Vercel) ---
# Upstash Redis REST credentials. Leave empty locally to use .data/store.json.
# The Vercel Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN for you;
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN also work.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Prefix for every Redis key, so one database can host several quests.
KEY_PREFIX=oq:

# --- Telegram mentor bot (optional) ---
TELEGRAM_BOT_TOKEN=
# The group chat id (a negative number). See README > Telegram bot setup.
TELEGRAM_CHAT_ID=
# The learner's numeric Telegram user id.
LEARNER_TELEGRAM_ID=
# Mentor user ids allowed to tick steps, comma separated.
TELEGRAM_ALLOWED_IDS=
# Optional forum topic ids: {"updates": 2, "humans": 3}. "updates" gets the
# pinned progress message; the bot stays silent in "humans".
TELEGRAM_TOPICS={}
# Any random string; Telegram sends it back on every webhook call.
WEBHOOK_SECRET=change-me-webhook-secret

# --- General ---
# Public URL of your deployment, used in bot messages and to register the webhook.
DASHBOARD_URL=http://localhost:3000
# IANA timezone for streaks, activity and bot timestamps.
TIMEZONE=UTC
PORT=3000
